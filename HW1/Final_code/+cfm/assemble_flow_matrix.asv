function [A, b] = assemble_flow_matrix(grid, p, Minf, U_inf, phi_prev)
    % assemble_flow_matrix Assembles the sparse system for potential flow.
    
    N_total = grid.Nx * grid.Ny;
    A = spalloc(N_total, N_total, 6 * N_total);
    b = zeros(N_total, 1);
    
    Cy = 1 / grid.dy^2;
    
    for j = 1:grid.Ny
        for i = 1:grid.Nx
            k = i + (j - 1) * grid.Nx;
            b_val = 0;
            
            % 1. Determining the Scheme in x (O Switch Transónico)
            % Cálculo da derivada dphi/dx na célula atual (diferenças centrais se possível)
            if i > 1 && i < grid.Nx
                dphi_dx = (phi_prev(k + 1) - phi_prev(k - 1)) / (2 * grid.dx);
            else
                dphi_dx = 0;
            end
            
            % Evaluation of the expression A local
            A_local = 1 - Minf^2 - ((p.gamma + 1) * Minf^2 / U_inf) * dphi_dx;
            
            if A_local >= 0
                % Locally Subsonic Regime -> Central Diferences
                Cx = A_local / grid.dx^2;
                a_W = Cx; a_E = Cx; a_N = Cy; a_S = Cy;
                a_P = -2 * (Cx + Cy); a_WW = 0;
            else
                % Locally Supersonic Regime -> Backward Differences (Upwind)
                Cx = -A_local / grid.dx^2; % Cx positive for upwind problems
                a_W = 2 * Cx; a_E = 0; a_N = Cy; a_S = Cy;
                a_P = -(Cx + 2 * Cy); a_WW = -Cx;
            end
            
            % 2. Boundary conditions
            if i == 1
                % Entry (Boundary A): Dirichlet
                a_P = 1; a_W = 0; a_E = 0; a_N = 0; a_S = 0; a_WW = 0;
                b_val = 0;
            else
                if i == grid.Nx
                    % Exit (Boundary C)
                    if A_local >= 0
                        % Subsonic: dphi/dx = 0 (Neumann)
                        a_P = a_P + a_E; a_E = 0;
                    end
                    % If supersonic, a_E is already 0 (Without any imposed condition)
                end
                if j == grid.Ny
                    % Top (Boundary B): dphi/dy = 0
                    a_P = a_P + a_N; a_N = 0;         
                end
                if j == 1
                    % Bottom (Boundary D e E): Flow tangent to the profile
                    fluxo = U_inf * grid.slope(i);
                    a_P = a_P + a_S; 
                    b_val = b_val + a_S * grid.dy * fluxo; 
                    a_S = 0; 
                end
            end
            
            % 3. Filling in the matrix
            A(k, k) = a_P;
            if a_W ~= 0,  A(k, k - 1) = a_W;  end
            if a_E ~= 0,  A(k, k + 1) = a_E;  end
            if a_S ~= 0,  A(k, k - grid.Nx) = a_S; end
            if a_N ~= 0,  A(k, k + grid.Nx) = a_N; end
            if a_WW ~= 0 && i > 2, A(k, k - 2) = a_WW; end
            
            b(k) = b_val;
        end
    end
end