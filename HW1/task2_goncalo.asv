% data

T_inf = 288;
p_inf = 101325;
Minf = 0.3;
c = 1;
t_2 = 0.03 * c;

R = 287;
gamma = 1.4;

U_inf = Minf* sqrt(gamma * R * T_inf);
R_inf = p_inf / (R * T_inf);

x_max = 3;
y_max = 2;
x_airfoil = 1;

Nx = 60;
Ny = 40;

%mesh

x_faces = linspace(0,x_max,Nx+1);
y_faces = linspace(0,y_max,Ny+1);

dx = x_max/Nx;
dy = y_max/Ny;

x_centers = x_faces(1:end-1) + dx/2;
y_centers = y_faces(1:end-1) + dy/2;

[X,Y] = meshgrid(x_centers,y_centers);

slope = zeros(1,Nx);

for i = 1:Nx
    x_pos = x_centers(i);

    if (x_pos >= x_airfoil) && (x_pos <= x_airfoil + c)
    
        if (x_pos <= c/2 + x_airfoil) 
            slope(i) = t_2/(c/2)
        end

        if (x_pos >= c/2 + x_airfoil)
            slope(i)= -t_2/(c/2)
        end 

    end

end


N_total = Nx * Ny;

A = spalloc(N_total, N_total, 5 * N_total);
b = zeros(N_total, 1);

%Coefficients

C_x = (1-Minf^2)/dx^2;
C_y = 1/dy^2;
C_p = -2*(C_x + C_y);

for j = 1: Ny
    for i = 1: Nx

        k = i + (j - 1)*Nx;

        a_W = C_x;
        a_E = C_x;
        a_N = C_y;
        a_S = C_y;
        a_P = C_p;
        b_val = 0;

        %Boundaries

        if i == 1

            a_P = a_P - a_W;
            a_W = 0;

        end

        if i == Nx
                a_P = a_P + a_E; 
                a_E = 0;         
        end

        if j == Ny
            a_P = a_P + a_N; 
            a_N = 0;         
        end

        if j == 1
            fluxo_fundo = U_inf * slope(i);
            a_P = a_P + a_S; 
            b_val = b_val + a_S * dy * fluxo_fundo; % Termo constante passa para o vetor b
            a_S = 0; 
        end



        A(k, k) = a_P;
        if a_W ~= 0, A(k, k - 1) = a_W; end
        if a_E ~= 0, A(k, k + 1) = a_E; end
        if a_S ~= 0, A(k, k - Nx) = a_S; end
        if a_N ~= 0, A(k, k + Nx) = a_N; end

        b(k) = b_val;
    end

end

phi_vector = A \ b;

phi = reshape(phi_vector, [Nx, Ny])';


[v, u] = gradient(phi, dx, dy);

% Cálculo do quadrado da velocidade total q^2
q_sq = (U_inf + u).^2 + v.^2;


T_ratio = 1 - ((gamma - 1) / 2) * Minf^2 * ((q_sq - U_inf^2) / U_inf^2);

T_local = T_ratio * T_inf;

rho_ratio = T_ratio .^ (1 / (gamma - 1));

% Cálculo do Número de Mach Local M = q / sqrt(gamma * R * T_local)[cite: 4]
M_local = sqrt(q_sq) ./ sqrt(gamma * R * T_local);

% Normalização do potencial phi para o gráfico (phi / (U_inf * c))[cite: 4]
phi_norm = phi / (U_inf * c);

figure('Name', 'Resultados FVM - Regime Subsónico (M = 0.3)', 'Position', [50, 50, 1200, 800]);

subplot(3, 1, 1);
contourf(X, Y, phi_norm, 30, 'LineColor', 'none'); 
colorbar;
hold on;
plot([x_airfoil, x_airfoil+c], [0 0], 'k-', 'LineWidth', 3); % Perfil
title('Campo de Potencial Normalizado: \phi / (U_\infty c)');
xlabel('x (m)'); ylabel('y (m)');
axis equal; axis([0 x_max 0 y_max]);


subplot(3, 1, 2);
contourf(X, Y, M_local, 30, 'LineColor', 'none');
colorbar;
hold on;
plot([x_airfoil, x_airfoil+c], [0 0], 'k-', 'LineWidth', 3);
title('Mach Number: M');
xlabel('x (m)'); ylabel('y (m)');
axis equal; axis([0 x_max 0 y_max]);


subplot(3, 1, 3);
contourf(X, Y, rho_ratio, 30, 'LineColor', 'none');
colorbar;
hold on;
plot([x_airfoil, x_airfoil+c], [0 0], 'k-', 'LineWidth', 3);
title('Relative Density: \rho / \rho_\infty');
xlabel('x (m)'); ylabel('y (m)');
axis equal; axis([0 x_max 0 y_max]);

colormap('jet');
